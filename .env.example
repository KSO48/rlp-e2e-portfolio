# Скопируй в .env.local и подставь свои значения.
# Реальные значения нигде в репозитории не хранятся.

BASE_URL=https://example-test-stand.example.com
APPLICANT_LOGIN=example-login
APPLICANT_PASSWORD=example-password
TEST_PASSWORD=example-password

# Chromium-Gost (сборка с поддержкой GOST TLS) + профиль с загруженным
# плагином КриптоПро (CAdES Browser Plug-in). Плагин грузится тестами из
# extensions/ через --load-extension, вручную ставить в профиль не нужно.
CHROMIUM_GOST_PATH=C:/path/to/chromium-gost/chrome.exe
CHROMIUM_GOST_PROFILE_DIR=C:/path/to/chromium-gost-profile
